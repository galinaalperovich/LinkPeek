{
  "manifest_version": 3,
  "name": "LinkPeek — AI link summaries",
  "short_name": "LinkPeek",
  "version": "1.0.0",
  "description": "Hold X and click any link for an AI summary in a bubble, then ask follow-up questions. You never leave the page.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/galinaalperovich/LinkPeek",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LinkPeek settings",
    "default_popup": "src/options/options.html?popup=1",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["src/lib/markdown.js", "src/ui/bubble-css.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "scripting", "contextMenus", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
